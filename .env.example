# Copy to .env, then `npm run build`.

# OAuth client ID of type "Chrome Extension" from Google Cloud Console
# (APIs & Services → Credentials), created for this extension's ID.
OAUTH_CLIENT_ID=

# Base64 public key that pins the extension ID across installs. Generate with:
#   openssl genrsa -out key.pem 2048
#   openssl rsa -in key.pem -pubout -outform DER | base64 -w0
# The extension ID is then:
#   openssl rsa -in key.pem -pubout -outform DER | sha256sum | head -c32 | tr 0-9a-f a-p
EXTENSION_KEY=
